{
  "rules": [
    {
      "pattern": "rm -rf",
      "severity": "CRITICAL",
      "description": "Destructive system deletion attempt detected"
    },
    {
      "pattern": "system\\(",
      "severity": "HIGH",
      "description": "Raw system shell call detected"
    },
    {
      "pattern": "eval\\(",
      "severity": "HIGH",
      "description": "Dynamic code evaluation detected"
    },
    {
      "pattern": "sudo",
      "severity": "MEDIUM",
      "description": "Privilege escalation attempt detected"
    }
  ]
}

